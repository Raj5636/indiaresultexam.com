rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read access to all documents
    match /{document=**} {
      allow read: if true;
    }
    
    // Allow write access to latest_jobs and settings collection for authenticated users
    match /latest_jobs/{document} {
      allow write: if request.auth != null;
    }
    
    match /settings/{document} {
      allow write: if request.auth != null;
    }
  }
}
